| <!DOCTYPE html>
| <html>
|   lang="en"
|   <head>
|     "
"
|     <meta>
|       charset="utf-8"
|     "
"
|     <title>
|       "browser: CSS values"
|     "
"
|     <link>
|       rel="stylesheet"
|       href="values-print.css"
|       media="print"
|     "
"
|     <link>
|       rel="stylesheet"
|       href="values-screen.css"
|       media="screen and (min-width: 400px)"
|     "
"
|     <style>
|       "
:root { --gap: 12px; --main: #c45500; --half: calc(50% - 20px); --bw: 3px; --line: var(--bw) solid var(--main); }
body { font-family: sans-serif; margin: 8px; }
div { margin: 4px 0; }
.custom { padding: var(--gap); background: var(--main); color: white; }
.half { width: var(--half); background: #dde; }
.fallback { margin-left: var(--missing, 30px); background: #eed; }
.override { --gap: 4px; background: #eee; }
.override .inner { padding: var(--gap); background: #ddf; }
.shorthand { border: var(--line); }
.unset { color: var(--missing); }
.calc { width: calc(100% - 2 * 10px); margin: 0 auto; background: #efe; }
.nested { width: calc((100% - 40px) / 2 + 1em); background: #fee; }
.min { width: min(300px, 50%); background: #eef; }
.clamp { width: clamp(100px, 20vw, 200px); background: #ffe; }
.font { font-size: calc(1rem + 2px); line-height: calc(1.5); }
.media { background: #fcc; }
@media (min-width: 600px) { .media { background: #cfc; } }
@media (max-width: 599px) { .media { background: #f00; } }
@media print { .media { color: #f00; } }
@media screen and (min-width: 700px) and (max-width: 900px) { .media { border: 2px solid #393; } }
@media not all and (min-width: 600px) { .media { border: 2px solid #f00; } }
@media (width >= 600px) { .range { background: #cfc; } }
@media (400px <= width <= 500px) { .range { background: #f00; } }
@media (prefers-reduced-motion: reduce) { .range { color: #f00; } }
@media (min-width: 1px) { @media (max-width: 10000px) { .deep { background: #cdf; } } }
@supports (display: flex) { .supports { border: 2px solid #393; } }
@supports not (display: flex) { .supports { background: #f00; } }
@supports (unknown-property: 1) { .supports { background: #f00; } }
@supports (display: grid) or (display: flex) { .supports { padding: 6px; } }
@supports (--css: variables) { .supports { color: #135; } }
.important { color: #393 !important; }
.important { color: #f00; }
.logical { margin-inline-start: 40px; padding-block: 6px 12px; padding-inline: 10px; background: #eee; }
.vmin { width: 25vmin; height: 10px; background: #999; }
"
|     "
"
|   "
"
|   <body>
|     "
"
|     <div>
|       class="custom"
|       "var() for the padding and the background."
|     "
"
|     <div>
|       class="half"
|       "A custom property holding a calc(): half the width less 20px."
|     "
"
|     <div>
|       class="fallback"
|       "A missing property's fallback: 30px on the left."
|     "
"
|     <div>
|       class="override"
|       <div>
|         class="inner"
|         "A property redefined on the parent: 4px padding."
|     "
"
|     <div>
|       class="shorthand"
|       "A border shorthand from var() within var()."
|     "
"
|     <div>
|       class="unset"
|       style="color: #336"
|       "A missing property without a fallback: the color is inherited."
|     "
"
|     <div>
|       class="calc"
|       "calc(100% - 2 * 10px), centered."
|     "
"
|     <div>
|       class="nested"
|       "Nested parentheses and an em."
|     "
"
|     <div>
|       class="min"
|       "min(300px, 50%)."
|     "
"
|     <div>
|       class="clamp"
|       "clamp(100px, 20vw, 200px)."
|     "
"
|     <div>
|       class="font"
|       "calc(1rem + 2px) text on calc(1.5) lines."
|     "
"
|     <div>
|       class="media"
|       "Media queries by width."
|     "
"
|     <div>
|       class="range"
|       "Media queries in the range form."
|     "
"
|     <div>
|       class="deep"
|       "A media rule inside a media rule."
|     "
"
|     <div>
|       class="supports"
|       "@supports."
|     "
"
|     <div>
|       class="important"
|       style="color: #00f"
|       "!important over a later rule and the style attribute."
|     "
"
|     <div>
|       class="logical"
|       "Logical margins and paddings."
|     "
"
|     <div>
|       class="vmin"
|     "
"
|     <div>
|       class="linked"
|       "The linked sheet for wide screens, not the one for print."
|     "


