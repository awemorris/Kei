| <!DOCTYPE html>
| <html>
|   <head>
|     "
"
|     <meta>
|       charset="utf-8"
|     "
"
|     <title>
|       "browser: positioning"
|     "
"
|     <style>
|       "
body { margin: 0; font-family: sans-serif; background: #f4f1ea; color: #222222; }
.stage { position: relative; margin: 20px; height: 300px; background: #ffffff; border: 2px solid #8a8272; }
.corner { position: absolute; width: 120px; height: 60px; background: #d9534f; color: #ffffff; }
.top-left { top: 10px; left: 10px; }
.top-right { top: 10px; right: 10px; background: #5b8def; }
.bottom-left { bottom: 10px; left: 10px; background: #3fa66b; }
.bottom-right { bottom: 10px; right: 10px; background: #e0a526; }
.label { position: absolute; top: 120px; left: 160px; background: #333333; color: #ffffff; padding: 4px 8px; }
.shifted { position: relative; left: 30px; top: 8px; background: #efe4c9; width: 300px; }
.below { position: absolute; top: 90px; left: 90px; width: 200px; height: 100px; background: #b9d7f5; z-index: -1; }
.over { position: absolute; top: 150px; left: 250px; width: 200px; height: 100px; background: #c77dd8; z-index: 2; }
.middle { position: absolute; top: 170px; left: 330px; width: 200px; height: 60px; background: #7fc7b8; z-index: 1; }
.stretch { position: absolute; top: 250px; left: 560px; right: 20px; bottom: 10px; background: #9e9e9e; }
.percent-shrink { position: absolute; top: 100px; left: 400px; padding: 8px; border: 1px solid; }
.percent-button { display: inline-block; box-sizing: border-box; width: 100%; text-align: center; }
.context-high { position: absolute; top: 30px; left: 500px; width: 60px; height: 60px; background: #6c4da3; z-index: 5; }
.context-child { position: absolute; top: 0; left: 40px; width: 60px; height: 60px; background: #f2d13d; }
.context-lower { position: absolute; top: 30px; left: 540px; width: 60px; height: 60px; background: #2675b8; z-index: 4; }
p { margin: 12px 20px; }
"
|     "
"
|   "
"
|   <body>
|     "
"
|     <div>
|       class="stage"
|       "
"
|       <div>
|         class="corner top-left"
|         "top left"
|       "
"
|       <div>
|         class="corner top-right"
|         "top right"
|       "
"
|       <div>
|         class="corner bottom-left"
|         "bottom left"
|       "
"
|       <div>
|         class="corner bottom-right"
|         "bottom right"
|       "
"
|       <span>
|         class="label"
|         "an absolute label that shrinks to fit"
|       "
"
|       <div>
|         class="below"
|         "z-index -1"
|       "
"
|       <div>
|         class="over"
|         "z-index 2"
|       "
"
|       <div>
|         class="middle"
|         "z-index 1"
|       "
"
|       <div>
|         class="stretch"
|       "
"
|       <div>
|         class="percent-shrink"
|         <a>
|           class="percent-button"
|           "sign in"
|         <div>
|           "new customer registration"
|       "
"
|       <div>
|         class="context-high"
|         <div>
|           class="context-child"
|       "
"
|       <div>
|         class="context-lower"
|       "
"
|     "
"
|     <p>
|       class="shifted"
|       "This paragraph is shifted by position: relative (30 pixels right, 8 down)."
|     "
"
|     <p>
|       "The page after the stage; the stage's absolute boxes take no room in the flow."
|     "
"
|     <script>
|       "
document.addEventListener("click", function (event) {
  console.log("clicked", event.target.className || event.target.tagName);
});
"
