| <!DOCTYPE html>
| <html>
|   lang="en"
|   <head>
|     "
"
|     <meta>
|       charset="utf-8"
|     "
"
|     <title>
|       "browser: external style sheets"
|     "
"
|     <link>
|       rel="stylesheet"
|       href="sheets-main.css"
|     "
"
|     <link>
|       rel="alternate stylesheet"
|       href="sheets-alt.css"
|     "
"
|     <link>
|       rel="stylesheet"
|       href="sheets-alt.css"
|       disabled=""
|     "
"
|     <style>
|       "
@import url("sheets-late.css");
.late { background: #cfc; }
"
|     "
"
|   "
"
|   <body>
|     "
"
|     <div>
|       id="a"
|       class="box one"
|       "An id and two classes: the id's background, the compound's border color."
|     "
"
|     <div>
|       class="box two"
|       "A class of the linked sheet and one of its import."
|     "
"
|     <p>
|       class="three"
|       "A type and a class, with the import's color."
|     "
"
|     <div>
|       class="late"
|       "A class of the style element, after the linked sheets."
|     "
"
|     <div>
|       class="imp"
|       "The import's !important background wins over the later normal one."
|     "
"
|     <section>
|       <div>
|         class="deep"
|         "A descendant selector filed under its class."
|     "
"
|     <div>
|       style="color: rgb(0, 0, 128)"
|       class="box"
|       "The style attribute's color."
|     "
"
|     <div>
|       class="imported-late"
|       "A rule of the style element's @import."
|     "


