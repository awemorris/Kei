-		'tag=$(ZEDBSD_NOCT_TAG)' \
-		'commit=$(ZEDBSD_NOCT_TAG_COMMIT)' \
-		'archive-sha256=$(ZEDBSD_NOCT_ARCHIVE_SHA256)' \
-		'patch-level=$(3)' \
+	printf '%s\n' $(call ZEDBSD_NOCT_IDENTITY,$(3),$(5)) \
