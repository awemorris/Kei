-		'archive-sha256=$(ZEDBSD_NOCT_ARCHIVE_SHA256)' \
-		'patch-level=$(2)'); \
+	expected=$$(printf '%s\n' $(call ZEDBSD_NOCT_IDENTITY,$(2),$(3))); \
 	actual=$$(cat "$$identity"); \
 	if test "$$actual" != "$$expected"; then \
 		echo "Noct: source identity mismatch: $$source" >&2; \
@@ -263,36 +276,47 @@
 	trap - EXIT HUP INT TERM
