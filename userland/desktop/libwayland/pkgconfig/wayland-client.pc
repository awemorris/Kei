# zedBSD's independent Wayland client library (userland/desktop/libwayland).
# Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
# The version is the upstream client ABI it follows (WS115 port-contract §5).
# The headers are in the sysroot's usr/include, so there are no Cflags.
prefix=/usr
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Wayland Client
Description: zedBSD Wayland client library
Version: 1.23.1
Libs: -L${libdir} -lwayland-client
Cflags:
