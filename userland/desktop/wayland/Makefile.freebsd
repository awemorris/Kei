# Native compositor membership reuses the shared renderer and real FreeBSD seat modules.
WAYLAND_FREEBSD_SOURCES := userland/desktop/wayland/main.c \
	userland/desktop/wayland/wire.c \
	userland/desktop/wayland/objects.c \
	userland/desktop/wayland/protocol.c \
	userland/desktop/wayland/display.c \
	userland/desktop/wayland/seat.c \
	userland/desktop/wayland/input.c \
	userland/desktop/wayland/tablet.c \
	userland/desktop/wayland/touch.c \
	userland/desktop/wayland/compose.c \
	userland/desktop/wayland/import.c \
	userland/desktop/wayland/shm.c \
	userland/desktop/wayland/glass.c \
	userland/desktop/wayland/shell.c \
	userland/desktop/wayland/home.c \
	userland/desktop/wayland/corner.c \
	userland/desktop/wayland/keyboard.c \
	userland/desktop/wayland/keyboard-layout.c \
	userland/desktop/wayland/keyboard-hand.c \
	userland/desktop/wayland/menu.c \
	userland/desktop/wayland/menu-shell.c \
	userland/desktop/wayland/titlebar.c \
	userland/desktop/wayland/popup.c \
	userland/desktop/wayland/toplevel.c \
	userland/desktop/wayland/sheet.c \
	userland/desktop/wayland/subsurface.c \
	userland/desktop/wayland/keymap.c \
	userland/desktop/wayland/data.c \
	userland/desktop/wayland/icons.c \
	userland/desktop/wayland/titlebar-shell.c \
	userland/desktop/wayland/decoration.c \
	userland/desktop/wayland/cursor.c \
	userland/desktop/wayland/viewport.c \
	userland/desktop/wayland/panels.c \
	userland/desktop/wayland/backdrop.c \
	userland/desktop/wayland/damage.c \
	userland/desktop/wayland/greeter.c \
	userland/desktop/wayland/primary.c \
	userland/desktop/wayland/network.c \
	userland/desktop/wayland/preferences.c \
	userland/desktop/wayland/volume.c \
	userland/desktop/wayland/text-input.c \
	userland/desktop/wayland/input-method.c \
	userland/desktop/wayland/desktop.c \
	userland/desktop/wayland/inset.c \
	userland/desktop/wayland/edit.c \
	userland/desktop/wayland/clipboard.c \
	userland/tests/vkdemo/display.c \
	userland/desktop/artwork/mark.c \
	userland/desktop/picture/color-glyph.c \
	userland/desktop/wayland/freebsd/os-freebsd.c \
	userland/desktop/wayland/freebsd/seat-freebsd.c \
	userland/desktop/wayland/evdev/input-evdev.c \
	userland/desktop/wayland/session/handoff-session.c \
	userland/desktop/wayland/dmabuf/gpu-dmabuf.c \
	userland/desktop/wayland/freebsd/sync-freebsd.c
$(eval $(call KEILAND_FREEBSD_PROGRAM,wayland,bin,$(WAYLAND_FREEBSD_SOURCES),libkeiland.so libkeiland-backend.a libtruetype.so libpng-compat.so libz-compat.so libvulkan.so.1 libseat.so.1,-lm -pthread))

# Native seat compilation cannot race the external client's generated public header.
$(KEILAND_FREEBSD_BUILD)/obj/userland/desktop/wayland/freebsd/seat-freebsd.o: $(KEILAND_FREEBSD_BUILD)/include/libseat.h

$(eval $(call KEILAND_FREEBSD_DATA,share/fonts/keiland.ttf,userland/desktop/fonts/Inter.ttf))
$(eval $(call KEILAND_FREEBSD_DATA,share/fonts/keiland-mono.ttf,userland/desktop/fonts/JetBrainsMono-Regular.ttf))
$(eval $(call KEILAND_FREEBSD_DATA,share/fonts/keiland-fallback.ttf,userland/desktop/fonts/DroidSansFallbackFull.ttf))
$(eval $(call KEILAND_FREEBSD_DATA,share/licenses/keiland-fonts/Inter-OFL.txt,userland/desktop/fonts/Inter-OFL.txt))
$(eval $(call KEILAND_FREEBSD_DATA,share/licenses/keiland-fonts/JetBrainsMono-OFL.txt,userland/desktop/fonts/JetBrainsMono-OFL.txt))
$(eval $(call KEILAND_FREEBSD_DATA,share/licenses/keiland-fonts/DroidSansFallback-LICENSE.txt,userland/desktop/fonts/DroidSansFallback-LICENSE.txt))
$(eval $(call KEILAND_FREEBSD_DATA,share/licenses/keiland-fonts/Apache-2.0.txt,userland/desktop/fonts/Apache-2.0.txt))

# Verify the pinned external font on both initial download and installation into the build tree.
KEILAND_FREEBSD_EMOJI := build/distfiles/NotoColorEmoji-2.047.ttf
$(KEILAND_FREEBSD_EMOJI):
	@mkdir -p $(dir $@)
	fetch -o $@.tmp https://github.com/googlefonts/noto-emoji/raw/v2.047/fonts/NotoColorEmoji.ttf
	test "$$(sha256 -q $@.tmp)" = "39ee3c587e10e89669b9ff32703261d10d5f9c4dd5ad147b6b5a1c5200591817"
	mv $@.tmp $@
$(KEILAND_FREEBSD_BUILD)/share/fonts/keiland-emoji.ttf: $(KEILAND_FREEBSD_EMOJI)
	test "$$(sha256 -q $<)" = "39ee3c587e10e89669b9ff32703261d10d5f9c4dd5ad147b6b5a1c5200591817"
	@mkdir -p $(dir $@)
	cp $< $@
KEILAND_FREEBSD_ALL += $(KEILAND_FREEBSD_BUILD)/share/fonts/keiland-emoji.ttf
KEILAND_FREEBSD_INSTALL += share/fonts/keiland-emoji.ttf
$(eval $(call KEILAND_FREEBSD_DATA,share/licenses/noto-color-emoji/OFL-1.1.txt,userland/packages/fonts/noto-color-emoji/OFL-1.1.txt))
