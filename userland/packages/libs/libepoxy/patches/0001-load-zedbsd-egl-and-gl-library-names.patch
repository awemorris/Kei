Load zedBSD's EGL and GL libraries by their own names.

epoxy finds the GL implementation at run time with dlopen(), by name.  On
an ELF system that is not Android it asks for the versioned names the
Linux libraries carry (libEGL.so.1, libGLESv2.so.2, libGL.so.1,
libOpenGL.so.0).  zedBSD's libraries in /lib have unversioned SONAMEs --
libEGL.so, libGLESv2.so and libGL.so (desktop GL and GLX) -- so every
lookup failed and epoxy reported no EGL.  The target compiler defines
__ZEDBSD__; with it, epoxy now asks for those names.  zedBSD has no GLES 1;
that name is only a placeholder.  Every other system is unchanged.

--- a/src/dispatch_common.c
+++ b/src/dispatch_common.c
@@ -188,6 +188,14 @@
 #define GLES1_LIB "libGLES_CM.dll"
 #define GLES2_LIB "libGLESv2.dll"
 #define OPENGL_LIB "OPENGL32"
+#elif defined(__ZEDBSD__)
+/* zedBSD's libraries in /lib carry unversioned SONAMEs: libEGL.so, libGLESv2.so
+ * and libGL.so, which holds desktop GL and its GLX.  There is no GLES 1. */
+#define GLX_LIB "libGL.so"
+#define EGL_LIB "libEGL.so"
+#define GLES1_LIB "libGLESv1_CM.so"
+#define GLES2_LIB "libGLESv2.so"
+#define OPENGL_LIB "libGL.so"
 #else
 #define GLVND_GLX_LIB "libGLX.so.1"
 #define GLX_LIB "libGL.so.1"
