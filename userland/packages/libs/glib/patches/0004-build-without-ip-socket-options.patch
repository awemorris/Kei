+/* A stack may lack the IP-level socket options (zedBSD has none): then the
+ * time-to-live, multicast loopback/TTL and group membership calls report
+ * G_IO_ERROR_NOT_SUPPORTED instead of failing to build. */
+#if defined(IP_TTL) && defined(IPV6_UNICAST_HOPS) && \
+    defined(IP_MULTICAST_LOOP) && defined(IPV6_MULTICAST_LOOP) && \
+    defined(IP_MULTICAST_TTL) && defined(IPV6_MULTICAST_HOPS) && \
+    defined(IP_ADD_MEMBERSHIP) && defined(IPV6_JOIN_GROUP)
+#define G_SOCKET_HAVE_IP_OPTIONS 1
+#endif
+
+/* POSIX names the largest listen backlog SOMAXCONN; a C library without it
+ * gets the traditional value, which only bounds the property. */
+#ifndef SOMAXCONN
+#define SOMAXCONN 128
+#endif
